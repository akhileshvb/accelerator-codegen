build/
build-*/
# build-* symlinks into scratch storage (a trailing slash only matches real directories)
build-*
.verus-solver-log/
benchmarks/tpch/results/
benchmarks/tpch/tmp/
benchmarks/sec_edgar/.venv/
benchmarks/sec_edgar/data/
benchmarks/sec_edgar/duckdb/
**/__pycache__/
docs/

# CTest in-source spill (if cmake runs from repo root)
Testing/

# Concurrent pack: per-worker builds, Codex homes, shared-file lease
pipeline/.locks/
pipeline/.codex/workers/
pipeline/worktrees/
pipeline/artifacts/packs/
# Foreign engine trees moved out of workspace during engine_backend from-scratch runs
pipeline/.quarantine/

# Pipeline run outputs (per-query state, gate JSON, rendered prompts, audits)
pipeline/artifacts/**
# Verus pipeline run workspaces and locks (--mode verus)
pipeline/verus_runs/
!pipeline/artifacts/shared/
!pipeline/artifacts/shared/optimization_playbook.md

# Local secrets (template: .env.example)
.env
.env.local

# Python orchestrator local env / build artifacts
pipeline/orchestrator/.venv/
pipeline/orchestrator/.pytest_cache/
*.egg-info/

# Local toolchain drops, Codex homes, scratch output
third_party/
pipeline/.codex/
tmp/

# Local Verus toolchain drop
tools/verus/

# orchestrator virtualenv (the MCP server launcher prefers it)
pipeline/orchestrator/.venv/
