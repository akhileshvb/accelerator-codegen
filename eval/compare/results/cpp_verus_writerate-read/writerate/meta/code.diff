-    else:
-        per_nation = SQL.replace(" ORDER BY numwait DESC, s_name LIMIT 100", "")
-        for nation, view in NATION_VIEW.items():
-            cur.execute(f"CREATE MATERIALIZED VIEW {view} AS " + cur.mogrify(per_nation, (nation,)).decode())
