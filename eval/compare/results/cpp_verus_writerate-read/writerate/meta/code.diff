-        return (log.stdout + log.stderr).count("mysql_accel_tpch_q1_verus(")
-
-    for off in OFFSETS:
-        sql = MY_SQL.format(off=off).replace("\n", " ")
-        verus = f"SELECT mysql_accel_tpch_q1_verus({off})"
