-    &&& 0 <= a.count <= m
-    &&& -m * s_val() <= a.qty <= m * s_val()
-    &&& -m * s_val() <= a.base <= m * s_val()
-    &&& -m * s_dp() <= a.disc_price <= m * s_dp()
