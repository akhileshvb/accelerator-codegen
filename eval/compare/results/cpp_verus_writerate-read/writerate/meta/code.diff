+fn copy_keys(source: &Vec<Major>, spare: usize) -> (result: Vec<Major>)
+    ensures result@ == source@,
+{
+    let mut result = Vec::with_capacity(match source.len().checked_add(spare) { Some(n) => n, None => source.len() });
+    let mut index = 0;
+    while index < source.len()
