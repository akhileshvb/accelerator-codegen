-    return true;
-  };
-  for (const auto &row : mutation.old_rows) {
-    if ((mutation.kind == core::MutationKind::Delete ||
-         mutation.kind == core::MutationKind::Update) &&
-        !add(row, -1)) {
-      buffer.MarkRebuild();
-      return;
-    }
-  }
-  for (const auto &row : mutation.new_rows) {
-    if ((mutation.kind == core::MutationKind::Insert ||
-         mutation.kind == core::MutationKind::Update) &&
-        !add(row, +1)) {
