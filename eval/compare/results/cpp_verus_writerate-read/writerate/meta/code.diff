-            entry["per_nation_ms"][n] = statistics.median(query(cur, system, n)[0] for _ in range(reps))
-        c.close()
-        res[system] = entry
-        print(f"read-only {system}: median over nations "
-              f"{statistics.median(entry['per_nation_ms'].values()):.3f} ms", flush=True)
