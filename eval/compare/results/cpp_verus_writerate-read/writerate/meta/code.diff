+      runtimes.push_back(std::make_unique<DuckdbRuntime>(wc, EntryFor(m.id), 10.0));
+      runtimes.back()->EnableMutationCapture();
+      const auto b0 = Clock::now();
+      runtimes.back()->Build();
+      const double ms = Us(b0, Clock::now()) / 1000;
+      build_ms_total += ms;
