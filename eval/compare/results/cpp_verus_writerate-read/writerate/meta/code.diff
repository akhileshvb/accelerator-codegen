-                        "'NONE', 'MAIL', 'bench')", (k, sk, ln, d))
-    else:
-        cur.execute("DELETE FROM lineitem WHERE l_orderkey = %s", (op[1],))
-        cur.execute("DELETE FROM orders WHERE o_orderkey = %s", (op[1],))
-
-
