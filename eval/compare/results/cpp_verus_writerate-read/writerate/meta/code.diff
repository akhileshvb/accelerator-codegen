+inline void MergeBranchless(const uint64_t *a, const uint64_t *a_end,
+                            const uint64_t *b, const uint64_t *b_end,
+                            uint64_t *out) {
+  while (a != a_end && b != b_end) {
+    const uint64_t x = *a, y = *b;
+    const bool take_b = y < x;
+    *out++ = take_b ? y : x;
