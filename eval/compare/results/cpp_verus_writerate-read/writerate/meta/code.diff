-    }
-
-    // Builds a state from correct parts; the invariant is what makes the resulting state usable and maintainable.
-    pub fn new(st: Arc<Static>, orders: OrderMap, wm: HashMap<i64, i64>, Ghost(db): Ghost<Db>) -> (r: State)
