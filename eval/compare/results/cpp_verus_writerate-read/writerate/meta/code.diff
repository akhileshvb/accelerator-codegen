+fn bytes_eq(a: &[u8], b: &[u8]) -> (r: bool)
+    ensures r == (a@ == b@),
+{
+    if a.len() != b.len() { return false; }
+    let mut i = 0usize;
+    while i < a.len()
+        invariant i <= a.len(), a.len() == b.len(), a@.len() == b@.len(),
+            forall|k: int| 0 <= k < i ==> a@[k] == b@[k],
+        decreases a.len() - i,
+    {
+        if a[i] != b[i] { return false; }
+        i += 1;
+    }
+    proof { assert(a@ =~= b@); }
+    true
