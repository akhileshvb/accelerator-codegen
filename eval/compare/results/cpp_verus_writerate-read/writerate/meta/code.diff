-
-    // Nations with suppliers, and orders whose lineitems they supply.
-    std::vector<std::string> nations;
-    {
-      auto r = Q(setup, "SELECT DISTINCT n_name FROM nation, supplier WHERE s_nationkey = n_nationkey "
-                        "ORDER BY 1 LIMIT 6");
