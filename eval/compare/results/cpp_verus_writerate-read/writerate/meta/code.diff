-VIEWS = ("mv", "mv_nation")
-PLAIN = ("base",) + VIEWS  # systems that run as plain PostgreSQL (capture triggers disabled)
-PLAIN_SETTINGS = ["SET enable_nestloop = off", "SET max_parallel_workers_per_gather = 8"]
-NATION_VIEW = {}  # nation -> its mv_nation view
