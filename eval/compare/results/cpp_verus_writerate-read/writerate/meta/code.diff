-const auto kQ10Better = [](const std::pair<int64_t, int64_t> &lhs,
-                           const std::pair<int64_t, int64_t> &rhs) {
-  if (lhs.second != rhs.second)
-    return lhs.second > rhs.second;
-  return lhs.first < rhs.first;
