+                        ",\"pre_commit_mean_us\":" + std::to_string(pre_commit_sum[q] / n_measured) +
+                        ",\"pre_commit_max_us\":" + std::to_string(pre_commit_max[q]) +
+                        ",\"install_mean_us\":" + std::to_string(install_sum[q] / n_measured)
