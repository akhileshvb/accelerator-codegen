-
-def backend_rss_anon_kb(cur, container):
-    cur.execute("SELECT pg_backend_pid()")
-    pid = cur.fetchone()[0]
-    out = subprocess.run(["docker", "exec", container, "grep", "RssAnon", f"/proc/{pid}/status"],
-                         capture_output=True, text=True).stdout
