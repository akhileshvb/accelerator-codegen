+        result.push(source[index]);
+        proof { assert(source@.take(index as int + 1) =~= source@.take(index as int).push(source@[index as int])); }
+        index += 1;
+    }
+    proof { assert(source@.take(source@.len() as int) =~= source@); }
+    result
