-pub proof fn lemma_mul_bound(a: int, b: int, ba: int, bb: int)
-    requires
-        0 < ba,
-        0 < bb,
-        -ba < a < ba,
-        -bb < b < bb,
-    ensures
-        -(ba * bb) < a * b < ba * bb,
-{
-    if a >= 0 && b >= 0 {
-        assert(a * b <= a * bb) by (nonlinear_arith)
-            requires a >= 0, b < bb;
-        assert(a * bb < ba * bb) by (nonlinear_arith)
-            requires a < ba, bb > 0;
-    } else if a < 0 && b < 0 {
-        assert((-a) * (-b) <= (-a) * bb) by (nonlinear_arith)
-            requires -a > 0, -b < bb;
-        assert((-a) * bb < ba * bb) by (nonlinear_arith)
-            requires -a < ba, bb > 0;
-        assert(a * b == (-a) * (-b)) by (nonlinear_arith);
-    } else if a >= 0 {
-        assert(a * (-b) <= a * bb) by (nonlinear_arith)
-            requires a >= 0, -b < bb;
-        assert(a * bb < ba * bb) by (nonlinear_arith)
-            requires a < ba, bb > 0;
-        assert(a * b == -(a * (-b))) by (nonlinear_arith);
-    } else {
-        assert((-a) * b <= (-a) * bb) by (nonlinear_arith)
-            requires -a > 0, b < bb;
-        assert((-a) * bb < ba * bb) by (nonlinear_arith)
-            requires -a < ba, bb > 0;
-        assert(a * b == -((-a) * b)) by (nonlinear_arith);
-    }
-}
