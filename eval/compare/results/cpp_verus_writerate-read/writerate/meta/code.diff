-  if (!ok || status != 0 || !carry.empty()) {
-    return false;
-  }
-  if (n > 0) {
-    batch.n = n;
-    if (!kernel.Consume(batch)) {
-      return false;
-    }
-  }
-  if (!kernel.Finish(groups)) {
-    return false;
-  }
