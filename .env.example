# Copy to .env and fill in values:
#   cp .env.example .env
#
# Load before running the pipeline (if not using auto-load in run_pipeline):
#   set -a && source .env && set +a

# --- Agent harness (codex exec via OpenRouter; see pipeline/config/models.yaml) ---
OPENROUTER_API_KEY=sk-or-v1-...

# --- DuckDB datasets (pipeline gates + benchmarks) ---
ACCEL_TPCH_DB=/path/to/datasets/tpch_sf1.duckdb
ACCEL_SEC_EDGAR_DB=/path/to/datasets/sec_edgar_sf3.duckdb
# Optional: manual SF20+ production benchmark (not run by pipeline gates)
# ACCEL_TPCH_SF20=/path/to/datasets/tpch_sf20.duckdb

# --- SEC EDGAR downloads (required by SEC.gov; use your real contact email) ---
SEC_EDGAR_USER_AGENT="accelerator-codegen you@example.com"

# --- Postgres differential / aux tests (optional) ---
PG_HOST=127.0.0.1
PG_PORT=5434
PG_USER=postgres
# PG_PASSWORD=
