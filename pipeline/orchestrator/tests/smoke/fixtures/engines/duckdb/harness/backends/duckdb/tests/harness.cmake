file(GLOB _duckdb_workload_queries CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/workloads/*/q*.sql")
set(_duckdb_benchmarks "")
foreach(_query_file IN LISTS _duckdb_workload_queries)
    get_filename_component(_workload_dir "${_query_file}" DIRECTORY)
    get_filename_component(_benchmark "${_workload_dir}" NAME)
    list(APPEND _duckdb_benchmarks "${_benchmark}")
endforeach()
list(REMOVE_DUPLICATES _duckdb_benchmarks)
list(SORT _duckdb_benchmarks)

foreach(_benchmark IN LISTS _duckdb_benchmarks)
    set(_definitions ACCEL_BENCHMARK_NAME="${_benchmark}" ACCEL_SOURCE_DIR="${CMAKE_CURRENT_SOURCE_DIR}")
    accel_add_backend_exe(duckdb test_duckdb_${_benchmark}_differential
        backends/duckdb/tests/harness/test_duckdb_differential.cpp)
    target_compile_definitions(test_duckdb_${_benchmark}_differential PRIVATE ${_definitions})
    accel_add_backend_exe(duckdb benchmark_duckdb_${_benchmark}_aux
        backends/duckdb/bench/benchmark_duckdb_aux.cpp)
    target_compile_definitions(benchmark_duckdb_${_benchmark}_aux PRIVATE ${_definitions})
    accel_add_backend_exe(duckdb calibrate_duckdb_${_benchmark}_aux_cost_model
        backends/duckdb/bench/calibrate_duckdb_aux_cost_model.cpp)
    target_compile_definitions(calibrate_duckdb_${_benchmark}_aux_cost_model PRIVATE ${_definitions})
endforeach()

foreach(_target IN ITEMS test_duckdb_aux_multi_connection_stress test_duckdb_cross_accel)
    if(_target STREQUAL "test_duckdb_aux_multi_connection_stress")
        set(_source backends/duckdb/tests/harness/test_duckdb_aux_multi_connection_stress.cpp)
    else()
        set(_source backends/duckdb/tests/harness/test_duckdb_cross_accel.cpp)
    endif()
    accel_add_backend_exe(duckdb ${_target} ${_source})
    target_compile_definitions(${_target} PRIVATE ACCEL_SOURCE_DIR="${CMAKE_CURRENT_SOURCE_DIR}")
endforeach()

file(GLOB_RECURSE _duckdb_aux_sources CONFIGURE_DEPENDS
    "${CMAKE_CURRENT_SOURCE_DIR}/accelerators/*/q*/duckdb/aux/finalize.cpp")
set(_duckdb_aux_queries "")
foreach(_aux_source IN LISTS _duckdb_aux_sources)
    if(_aux_source MATCHES "/accelerators/([^/]+)/q([0-9]+)/duckdb/aux/finalize\\.cpp$")
        list(APPEND _duckdb_aux_queries "${CMAKE_MATCH_1}|${CMAKE_MATCH_2}")
    endif()
endforeach()
list(REMOVE_DUPLICATES _duckdb_aux_queries)
foreach(_aux_query IN LISTS _duckdb_aux_queries)
    if(_aux_query MATCHES "^([^|]+)\\|([0-9]+)$")
        set(_benchmark "${CMAKE_MATCH_1}")
        set(_query "${CMAKE_MATCH_2}")
        set(_target "test_${_benchmark}_q${_query}_aux")
        if(NOT TARGET ${_target})
            accel_add_backend_exe(duckdb ${_target} backends/duckdb/tests/harness/test_duckdb_aux_module.cpp)
            target_compile_definitions(${_target} PRIVATE ACCEL_BENCHMARK_NAME="${_benchmark}"
                ACCEL_SOURCE_DIR="${CMAKE_CURRENT_SOURCE_DIR}" ACCEL_QUERY_NUMBER=${_query})
        endif()
        if(BUILD_TESTING AND NOT TEST "${_benchmark}_q${_query}_aux_smoke_test")
            add_test(NAME ${_benchmark}_q${_query}_aux_smoke_test COMMAND ${_target})
            set_tests_properties(${_benchmark}_q${_query}_aux_smoke_test PROPERTIES
                FIXTURES_REQUIRED ${_benchmark}_test_db
                ENVIRONMENT "ACCEL_DB=${ACCEL_TEST_DB_DIR}/${_benchmark}_test.duckdb")
        endif()
    endif()
endforeach()
