{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://accelerator-codegen.local/schemas/materialized_view_analysis.schema.json",
  "title": "MaterializedViewAnalysis",
  "type": "object",
  "required": [
    "accelerator_id",
    "mv_function_name",
    "mv_relation_name",
    "fitness_assessment",
    "correctness_facts",
    "files_to_create"
  ],
  "additionalProperties": true,
  "properties": {
    "accelerator_id": { "type": "string", "minLength": 1 },
    "mv_function_name": { "type": "string", "minLength": 1 },
    "mv_relation_name": { "type": "string", "minLength": 1 },
    "fitness_assessment": {
      "type": "object",
      "required": ["recommended", "confidence", "scope", "signals_for", "signals_against", "rationale"],
      "properties": {
        "recommended": { "type": "boolean" },
        "confidence": { "enum": ["high", "medium", "low"] },
        "scope": { "const": "per_query" },
        "signals_for": { "type": "array", "items": { "type": "string" } },
        "signals_against": { "type": "array", "items": { "type": "string" } },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "matview_candidate_search": {
      "type": "object",
      "properties": {
        "fewer_than_three_explanation": { "type": ["string", "null"] },
        "candidates": {
          "type": "array",
          "items": { "$ref": "#/$defs/matview_candidate" }
        }
      }
    },
    "correctness_facts": {
      "type": "object",
      "required": [
        "dependent_tables",
        "selected_candidate_id",
        "create_materialized_view_sql",
        "index_sql",
        "residual_query_sql",
        "refresh_sql",
        "refresh_mode",
        "state_grain",
        "output_grain",
        "is_full_result_cache",
        "mutation_coverage",
        "correctness_argument",
        "speedup_argument"
      ],
      "properties": {
        "dependent_tables": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "watched_columns"],
            "properties": {
              "name": { "type": "string" },
              "watched_columns": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
              "role": { "type": "string" }
            }
          }
        },
        "selected_candidate_id": { "type": "string", "minLength": 1 },
        "create_materialized_view_sql": { "type": "string", "minLength": 1 },
        "index_sql": { "type": "array", "items": { "type": "string" } },
        "residual_query_sql": { "type": "string", "minLength": 1 },
        "refresh_sql": { "type": "string", "minLength": 1 },
        "refresh_mode": { "enum": ["refresh", "refresh_concurrently"] },
        "state_grain": { "type": "string", "minLength": 1 },
        "output_grain": { "type": "string", "minLength": 1 },
        "is_full_result_cache": { "type": "boolean" },
        "mutation_coverage": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["table", "mutation", "behavior"],
            "properties": {
              "table": { "type": "string" },
              "mutation": { "type": "string", "enum": ["insert", "update", "delete"] },
              "behavior": { "const": "refresh_materialized_view" },
              "notes": { "type": "string" }
            }
          }
        },
        "correctness_argument": { "type": "string", "minLength": 1 },
        "speedup_argument": { "type": "string", "minLength": 1 },
        "alternatives_considered": { "type": "array", "minItems": 2 }
      }
    },
    "performance_hypotheses": {
      "type": "object",
      "properties": {
        "base_path_cost_decomposition": { "type": "object" },
        "refresh_cost_hypothesis": { "type": "string" },
        "read_path_hypothesis": { "type": "string" }
      }
    },
    "files_to_create": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "role"],
        "properties": {
          "path": { "type": "string" },
          "role": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "matview_candidate": {
      "type": "object",
      "required": ["id", "design_family", "state_grain", "defining_select_sketch", "viability"],
      "properties": {
        "id": { "type": "string" },
        "design_family": {
          "type": "string",
          "description": "e.g. preagg_summary, join_intermediate, narrow_prefilter, covering_projection"
        },
        "state_grain": { "type": "string" },
        "defining_select_sketch": { "type": "string" },
        "proposed_indexes": { "type": "array", "items": { "type": "string" } },
        "residual_query_sketch": { "type": "string" },
        "refresh_mode": { "enum": ["refresh", "refresh_concurrently"] },
        "operators_eliminated": { "type": "array", "items": { "type": "string" } },
        "read_path_bottleneck_risk": { "enum": ["low", "medium", "high"] },
        "best_regime": { "type": "string" },
        "viability": { "enum": ["viable", "rejected"] },
        "rejection_reason": { "type": "string" },
        "selected": { "type": "boolean" }
      }
    }
  }
}
