-- Build only parameter-independent daily contributions. EXISTS preserves bags.
scan qualifying_orders AS DatePriorityInput:
  SELECT o_orderdate, o_orderpriority
  FROM orders
  WHERE EXISTS (
    SELECT * FROM lineitem
    WHERE l_orderkey = o_orderkey AND l_commitdate < l_receiptdate
  );

-- Post-state order variants are needed only at qualifying line-change keys.
rescan orders_for_line_changes AS OrderInput KEYS o_orderkey:
  SELECT o_orderkey, o_orderdate, o_orderpriority FROM orders;

-- Count these post-state witnesses at order-change or qualifying line-change keys.
rescan qualifying_lines_for_keys AS QualifyingLineKeyInput KEYS l_orderkey:
  SELECT l_orderkey FROM lineitem WHERE l_commitdate < l_receiptdate;

delta orders AS OrderDelta OF OrderInput:
  SELECT o_orderkey, o_orderdate, o_orderpriority FROM orders;

-- A computed commitdate < receiptdate capture flag is not supported by the DSL.
-- These three numeric fields are the minimal legal exact predicate capture.
delta lineitem AS LineDelta OF LineInput:
  SELECT l_orderkey, l_commitdate, l_receiptdate FROM lineitem;
