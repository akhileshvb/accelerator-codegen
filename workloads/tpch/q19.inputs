scan qualifying_parts AS PartInput:
SELECT p_partkey, p_brand, p_size, p_container
FROM part
WHERE (p_size >= 1 AND p_size <= 5
       AND p_container IN ('SM CASE', 'SM BOX', 'SM PACK', 'SM PKG'))
   OR (p_size >= 1 AND p_size <= 10
       AND p_container IN ('MED BAG', 'MED BOX', 'MED PKG', 'MED PACK'))
   OR (p_size >= 1 AND p_size <= 15
       AND p_container IN ('LG CASE', 'LG BOX', 'LG PACK', 'LG PKG'));

scan qualifying_lines AS LineInput:
SELECT l_partkey, l_quantity, l_extendedprice, l_discount
FROM lineitem
WHERE l_shipmode IN ('AIR', 'AIR REG')
  AND l_shipinstruct = 'DELIVER IN PERSON'
  AND EXISTS (
      SELECT p_partkey FROM part
      WHERE p_partkey = l_partkey
        AND ((p_size >= 1 AND p_size <= 5
              AND p_container IN ('SM CASE', 'SM BOX', 'SM PACK', 'SM PKG'))
          OR (p_size >= 1 AND p_size <= 10
              AND p_container IN ('MED BAG', 'MED BOX', 'MED PKG', 'MED PACK'))
          OR (p_size >= 1 AND p_size <= 15
              AND p_container IN ('LG CASE', 'LG BOX', 'LG PACK', 'LG PKG')))
  );

rescan lines_for_parts AS LineInput KEYS l_partkey:
SELECT l_partkey, l_quantity, l_extendedprice, l_discount
FROM lineitem
WHERE l_shipmode IN ('AIR', 'AIR REG')
  AND l_shipinstruct = 'DELIVER IN PERSON';

delta lineitem AS LineDelta:
SELECT l_partkey, l_quantity, l_extendedprice, l_discount,
       ((l_shipmode = 'AIR' OR l_shipmode = 'AIR REG')
        AND l_shipinstruct = 'DELIVER IN PERSON') AS eligible
FROM lineitem;

delta part AS PartDelta:
SELECT p_partkey, p_brand,
       (p_size >= 1 AND p_size <= 5
        AND (p_container = 'SM CASE' OR p_container = 'SM BOX'
             OR p_container = 'SM PACK' OR p_container = 'SM PKG')) AS small,
       (p_size >= 1 AND p_size <= 10
        AND (p_container = 'MED BAG' OR p_container = 'MED BOX'
             OR p_container = 'MED PKG' OR p_container = 'MED PACK')) AS medium,
       (p_size >= 1 AND p_size <= 15
        AND (p_container = 'LG CASE' OR p_container = 'LG BOX'
             OR p_container = 'LG PACK' OR p_container = 'LG PKG')) AS large
FROM part;
